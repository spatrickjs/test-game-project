@tool
extends EditorScript
## One-time approved scene configuration. Leaves authored scenery untouched.

func _run() -> void:
	await run_setup()

func run_setup() -> int:
	var tree: SceneTree = EditorInterface.get_base_control().get_tree()
	for frame: int in range(10):
		await tree.process_frame
	while EditorInterface.get_resource_filesystem().is_scanning():
		await tree.process_frame
	var path: String = "res://field_prototype.tscn"
	EditorInterface.open_scene_from_path(path)
	for frame: int in range(5):
		await tree.process_frame
	var scene: Node = EditorInterface.get_edited_scene_root()
	if scene == null or scene.scene_file_path != path:
		return 1
	var farming: Node = scene.get("farming_controller") as Node
	var world: Node = scene.get("world_view") as Node
	var preview: Node = world.get_node("TerrainPreview")
	farming.set("field_size", Vector2i(9, 9))
	world.set("automatic_background_enabled", false)
	var automatic: TileMapLayer = world.get("background_fill_layer") as TileMapLayer
	if automatic != null:
		if not automatic.get_used_cells().is_empty() or automatic.get_child_count() > 0:
			push_error("AutomaticGrassBackground contains authored content; cleanup cancelled.")
			return 1
		world.set("background_fill_layer", null)
		automatic.get_parent().remove_child(automatic)
		automatic.free()
	var descriptions: Dictionary[String, String] = {
		"BackgroundTerrain": "PAINT HERE: manual ground outside the 9x9 playable area (coordinates 0..8 on both axes).",
		"BackgroundDecorations": "DESIGN HERE: scenery tiles and child sprites/scenes such as trees, roads and foliage.",
		"TerrainPreview": "EDITOR GUIDE: previews the 9x9 playable area. Do not paint here; generated preview is not saved.",
		"Terrain": "RUNTIME: playable terrain generated by FarmingController. Manual tiles here are overwritten.",
		"GrassOverlayLayer": "RUNTIME: animated grass tufts on playable grass cells; cleared when plots are dug.",
		"Crops": "RUNTIME: crop growth artwork, updated by planting and farming actions.",
		"CropOverlay": "DIAGNOSTICS: hidden crop-state overlay retained for debugging and integration checks.",
		"CropShadows": "RUNTIME: procedural shadows beneath occupied plots.",
		"SelectionOverlay": "RUNTIME: eligible, selected and queued plot highlights.",
		"FarmerAgent": "RUNTIME: placeholder farmer that walks to queued tasks.",
		"Camera2D": "RUNTIME: camera controlled by FieldWorldView framing, pan and zoom.",
	}
	for node_name: String in descriptions:
		var child: Node = world.get_node_or_null(NodePath(node_name))
		if child != null:
			child.editor_description = descriptions[node_name]
	var editor_nodes: Array[String] = ["BackgroundTerrain", "BackgroundDecorations", "TerrainPreview"]
	for index: int in range(editor_nodes.size()):
		world.move_child(world.get_node(NodePath(editor_nodes[index])), index)
	preview.set("preview_enabled", true)
	preview.set("background_preview_enabled", false)
	preview.call("refresh_preview")
	var uid: int = ResourceLoader.get_resource_uid(path)
	EditorInterface.mark_scene_as_unsaved()
	EditorInterface.save_scene_as(path, false)
	if ResourceLoader.get_resource_uid(path) != uid:
		return 1
	print("MANUAL_WORLD_SETUP_PASS")
	return 0
